# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram.
BOT_TOKEN=

# Local development uses SQLite; production uses Postgres.
#   sqlite+aiosqlite:///./price_tracker.db
#   postgresql+asyncpg://user:pass@host:5432/dbname
#
# On Supabase, use the *session pooler* string (Connect > Session pooler), not the
# direct one: the direct host is IPv6-only on the free plan, and Docker and most
# servers are IPv4. It can be pasted as the dashboard shows it; `postgresql://` and
# `sslmode=` are rewritten for the async driver on load. Add ssl=require:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./price_tracker.db

# Sent on every outbound store request so operators can identify and contact us.
# Keep it truthful: a real project URL, not a browser impersonation string.
SCRAPER_USER_AGENT=price-tracker-bot/0.1 (+https://github.com/EmilioPG13/price-tracker-bot)

# Hours between automated price checks.
CHECK_INTERVAL_HOURS=6
